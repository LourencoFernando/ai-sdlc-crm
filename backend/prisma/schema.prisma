// Calendar dates (close_date, occurred_on, follow_up_on) are stored as
// YYYY-MM-DD strings so they never move with the time zone.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id        Int       @id @default(autoincrement())
  name      String
  website   String?
  industry  String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  contacts  Contact[]
  deals     Deal[]

  @@map("organizations")
}

model Contact {
  id             Int           @id @default(autoincrement())
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  email          String?       @unique
  phone          String?
  jobTitle       String?       @map("job_title")
  organizationId Int?          @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status         String        @default("lead")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deals          Deal[]
  activities     Activity[]

  @@index([organizationId])
  @@map("contacts")
}

model Deal {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int          @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contactId      Int?         @map("contact_id")
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  stage          String
  value          Int
  probability    Int
  closeDate      String       @map("close_date")
  position       Int
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  activities     Activity[]

  @@index([organizationId])
  @@index([contactId])
  @@index([stage, position])
  @@map("deals")
}

model Activity {
  id          Int      @id @default(autoincrement())
  kind        String
  contactId   Int?     @map("contact_id")
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: Restrict)
  dealId      Int?     @map("deal_id")
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: Restrict)
  description String
  occurredOn  String   @map("occurred_on")
  followUpOn  String?  @map("follow_up_on")
  done        Boolean  @default(false)
  fromStage   String?  @map("from_stage")
  toStage     String?  @map("to_stage")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([contactId])
  @@index([dealId])
  @@index([followUpOn, done])
  @@map("activities")
}
