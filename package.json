{
  "name": "accountable",
  "version": "0.1.0",
  "private": true,
  "description": "Accountable, a sales CRM that runs on your own computer",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run db:deploy -w backend && concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "seed": "npm run seed -w backend",
    "test": "node scripts/test.mjs",
    "test:e2e": "npm run build -w backend && playwright test",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "check": "node scripts/check.mjs",
    "check:quick": "node scripts/check.mjs --quick",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "multer": "2.5.0",
    "@prisma/config": {
      "effect": "3.22.4"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@parcel/watcher": false,
    "lefthook@2.2.2": true
  }
}
